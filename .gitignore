# ============================================================
# 只提交源代码和部署配置。
# 先忽略所有，再按下面的白名单逐项放行；
# 文档、图片、构建产物、IDE 配置、.env 密钥一律不提交。
# ============================================================
/*

# --- 仓库元数据 ---
!/.gitignore
!/.gitattributes

# --- 后端构建与源码 ---
!/pom.xml
!/mvnw
!/mvnw.cmd
!/.mvn/
/.mvn/wrapper/maven-wrapper.jar
!/src/

# 上传的菜品图片属于运行时数据，不提交
/src/main/resources/image/

# --- 前端源码与构建配置 ---
!/frontend/
/frontend/*
!/frontend/src/
!/frontend/.gitignore
!/frontend/index.html
!/frontend/package.json
!/frontend/package-lock.json
!/frontend/pnpm-lock.yaml
!/frontend/pnpm-workspace.yaml
!/frontend/vite.config.js
!/frontend/Dockerfile
!/frontend/.dockerignore
!/frontend/nginx.conf

# --- Docker 镜像与编排 ---
!/Dockerfile
!/.dockerignore
!/docker-compose.yml

# --- production 部署包：只放 Docker 配置，.env / dist / jar 仍忽略 ---
!/production/
/production/*
!/production/docker-compose.yml
!/production/back/
/production/back/*
!/production/back/Dockerfile
!/production/frontend/
/production/frontend/*
!/production/frontend/Dockerfile
!/production/frontend/nginx.conf
